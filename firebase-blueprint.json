{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator grant record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified email address of the administrator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was recorded."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time internal operational dispatch message for MUANS Kolwezi teams.",
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["kolwezi-dispatch"],
          "maxLength": 32,
          "description": "Dispatch channel identifier."
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID of the sender."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the sender."
        },
        "senderRole": {
          "type": "string",
          "enum": ["Chauffeur", "Commerçant", "Employé", "Admin"],
          "maxLength": 24,
          "description": "Operational role selected by the sender."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Message body."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "channel",
        "senderUid",
        "senderName",
        "senderRole",
        "message",
        "createdAt"
      ]
    },
    "DeliveryOrder": {
      "title": "DeliveryOrder",
      "description": "MUANS GO delivery dispatch order created by merchants/staff and accepted by drivers.",
      "type": "object",
      "properties": {
        "creatorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase UID of the operator who created the order."
        },
        "creatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the order creator."
        },
        "customer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Customer or destination label in Kolwezi."
        },
        "details": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "description": "Delivery package or route details."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "completed", "cancelled"],
          "maxLength": 20,
          "description": "Order lifecycle status."
        },
        "acceptedByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the driver who accepted the order (empty string when pending)."
        },
        "acceptedByName": {
          "type": "string",
          "maxLength": 80,
          "description": "Display name of the driver who accepted the order (empty string when pending)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "creatorUid",
        "creatorName",
        "customer",
        "details",
        "status",
        "acceptedByUid",
        "acceptedByName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Verified administrator role documents."
    },
    "/kolwezi_chat/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Internal real-time dispatch chat messages for Kolwezi operations."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/DeliveryOrder" },
      "description": "MUANS GO delivery orders queue and lifecycle records."
    }
  }
}
